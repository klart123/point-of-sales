require 'dotenv'

# Load environment variables
Dotenv.load('.env.release')

default_platform(:android)

platform :android do

  desc "Increment Android version"
  lane :increment_version do |options|
    gradle_file = "android/app/build.gradle"

    current_version_name = ENV['ANDROID_VERSION_NAME']
    current_version_code = ENV['ANDROID_VERSION_CODE'].to_i

    UI.message("Current version name: #{current_version_name}")
    UI.message("Current version code: #{current_version_code}")

    parts = current_version_name.split('.').map(&:to_i)
    bump_type = options[:bump] || "patch"

    case bump_type
    when "major"
      parts[0] += 1
      parts[1] = 0
      parts[2] = 0
    when "minor"
      parts[1] += 1
      parts[2] = 0
    else
      parts[2] = (parts[2] || 0) + 1
    end

    new_version_name = parts.join('.')
    new_version_code = current_version_code + 1

    android_set_version_name(
      gradle_file: gradle_file,
      version_name: new_version_name
    )

    android_set_version_code(
      gradle_file: gradle_file,
      version_code: new_version_code
    )

    env_file = File.read('.env')

    env_file.gsub!(
      /ANDROID_VERSION_CODE=\d+/,
      "ANDROID_VERSION_CODE=#{new_version_code}"
    )

    env_file.gsub!(
      /ANDROID_VERSION_NAME=[^\n]+/,
      "ANDROID_VERSION_NAME=#{new_version_name}"
    )

    File.write('.env.release', env_file)

    UI.success(
      "Updated versionName=#{new_version_name} versionCode=#{new_version_code}"
    )
  end

  desc "Build Android Release APK"
  lane :build do

    gradle(
      task: "clean",
      project_dir: "android"
    )

    build_android_app(
      task: "assemble",
      project_dir: "android",
      build_type: "Release",
      properties: {
        "RELEASE_STORE_FILE" => ENV["RELEASE_STORE_FILE"],
        "RELEASE_KEY_ALIAS" => ENV["RELEASE_KEY_ALIAS"],
        "RELEASE_STORE_PASSWORD" => ENV["RELEASE_STORE_PASSWORD"],
        "RELEASE_KEY_PASSWORD" => ENV["RELEASE_KEY_PASSWORD"]
      }
    )
  end

  desc "Upload Android APK to Firebase"
  lane :upload do

    apk_path = Actions.lane_context[
      SharedValues::GRADLE_APK_OUTPUT_PATH
    ]

    firebase_app_distribution(
      app: ENV["APP_ID_ANDROID"],
      groups: ENV["TESTER_GROUPS"],
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: apk_path,
      release_notes_file: "fastlane/release-notes/en.txt"
    )
  end

  desc "Deploy Android Release"
  lane :deploy do |options|
    increment_version(bump: options[:bump] || "patch")
    build
    upload
  end

end

platform :ios do

  private_lane :build_app_scheme do |options|

    scheme = options[:scheme]

    build_ios_app(
      scheme: scheme,
      workspace: "./ios/PointOfSsales.xcworkspace",
      clean: true,
      export_method: "development",
      output_directory: "./ios/build_ipa",
      output_name: "#{scheme}.ipa",
      xcargs: "-allowProvisioningUpdates",
    )
  end

  private_lane :upload_app_scheme do |options|

    scheme = options[:scheme]

    firebase_app_distribution(
      app: ENV["APP_ID_IOS"],
      groups: ENV["TESTER_GROUPS"],
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      ipa_path: "./ios/build_ipa/#{scheme}.ipa",
      release_notes_file: "fastlane/release-notes/en.txt"
    )
  end

  desc "Build iOS"
  lane :build do |options|

    scheme = options[:scheme] || "Release PointOfSsales"

    sh("rm -rf ios/build_ipa")
    sh("mkdir -p ios/build_ipa")

    build_app_scheme(
      scheme: scheme
    )
  end

  desc "Upload iOS IPA"
  lane :upload do |options|

    scheme = options[:scheme] || "Release PointOfSsales"

    upload_app_scheme(
      scheme: scheme
    )
  end

  desc "Deploy iOS to Firebase"
  lane :deploy do |options|

    scheme = options[:scheme] || "Release PointOfSsales"

    build(
      scheme: scheme
    )

    upload(
      scheme: scheme
    )
  end

end